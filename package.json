{
  "name": "semantic-canvas",
  "version": "0.1.0",
  "description": "An open-source BI tool that reads the semantic layer you already have, suggests a dashboard from it, and lets you rearrange the result on a canvas.",
  "license": "MIT",
  "private": true,
  "author": "Evinanderson89 (https://github.com/Evinanderson89)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Evinanderson89/semantic-canvas.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "server": "tsx src/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "start": "concurrently -k \"npm:server\" \"npm:dev\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "e2e": "playwright test",
    "serve": "SC_SERVE_UI=true tsx src/server.ts",
    "backup": "tsx scripts/library.ts backup",
    "restore": "tsx scripts/library.ts restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@duckdb/node-api": "1.5.5-r.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@observablehq/plot": "^0.6.16",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/topojson-client": "^3.1.5",
    "d3": "^7.9.0",
    "express": "^4.21.1",
    "html-to-image": "^1.11.13",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "snowflake-sdk": "^3.3.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "world-atlas": "^2.0.2",
    "yaml": "^2.6.1",
    "zod": "^4.5.4",
    "jose": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "snowflake-sdk": {
      "toml": "^5.0.0"
    },
    "express": {
      "qs": "^6.16.0"
    }
  }
}
