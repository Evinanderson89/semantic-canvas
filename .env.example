# Copy to .env and fill in what you need. Loaded automatically on `npm start`.
#
# The bundled duckdb source (see sources.yaml) needs none of this -- it's
# only for attaching a warehouse-backed source like the dbt-on-Snowflake
# example in sources.yaml.

# --- Snowflake (only if you uncomment a snowflake connector in sources.yaml) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Key-pair auth is preferred for a service account; set the key and it wins
# over SNOWFLAKE_PASSWORD below.
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASS=
# Only used if SNOWFLAKE_PRIVATE_KEY is unset.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC

# --- Server (optional overrides) ---
# SOURCES_PATH=./sources.yaml
# RLS_PATH=./security/policies.yaml
# PORT=5174
