SC_DOMAIN=analytics.example.com
SC_PUBLIC_URL=https://analytics.example.com
SC_OIDC_ISSUER=https://your-provider.example.com
SC_OIDC_CLIENT_ID=replace-with-client-id
SC_OIDC_CLIENT_SECRET=replace-with-client-secret
SC_OIDC_SCOPES=openid profile email
SC_SESSION_SECONDS=3600
