SC_DOMAIN=analytics.example.com
SC_PUBLIC_URL=https://analytics.example.com
SC_OIDC_ISSUER=https://your-provider.example.com
SC_OIDC_CLIENT_ID=replace-with-client-id
SC_OIDC_CLIENT_SECRET=replace-with-client-secret
SC_OIDC_SCOPES=openid profile email
# Optional: client_secret_basic for providers or applications that accept the secret only in the Authorization header (Okta web apps by default).
# SC_OIDC_CLIENT_AUTH=client_secret_basic
SC_SESSION_SECONDS=3600
# Optional: seconds one chart query, filter lookup or alert check may run before it is cancelled (default 120; 0 disables).
# SC_QUERY_TIMEOUT_SECONDS=120
# Optional per-account limits per minute (defaults shown; 0 disables one).
# SC_RATE_AI_PER_MINUTE=30
# SC_RATE_QUERY_PER_MINUTE=600
# SC_RATE_API_PER_MINUTE=1200
# Optional: OTLP/HTTP, not gRPC. Point this at your own collector or compatible vendor.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20replace-with-token
OTEL_SERVICE_NAME=semantic-canvas
